---
import '@fontsource/tiny5/latin-400.css';
import '../styles/global.css';
import logo from '../components/logo-block.svg?raw';
import grassStrip from '../components/grass-strip.svg?raw';
import { DECLARED_NOTE } from '../lib/ui/status';
import { meta } from '../lib/build-data';

interface Props {
  title: string;
  description: string;
  /** social preview image path (generated by pipeline/og.ts into dist/og) */
  ogImage?: string;
}
const { title, description, ogImage = '/og/index.png' } = Astro.props;
const ogUrl = new URL(ogImage, Astro.site);
const m = meta();
const canonical = new URL(Astro.url.pathname, Astro.site);
// Affiliate + donation links. Plain links via our own /go/ redirect: no third-party scripts or cookies.
const KOFI = import.meta.env.PUBLIC_KOFI_URL as string | undefined;
const grassUrl = `url("data:image/svg+xml,${encodeURIComponent(grassStrip.trim())}")`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mcmodsready" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2f7d32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <!-- Cloudflare Web Analytics: cookieless, aggregate page-view counts only. Token is public by design. -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "1c9c1a8331894123b25f96874964dd07"}'></script>
  </head>
  <body>
    <header class="site-header" style={`--grass-strip: ${grassUrl}`}>
      <div class="wrap row">
        <a class="brand" href="/" aria-label="mcmodsready home"><span class="logo" set:html={logo} /><span>mc<span class="m">mods</span><b>ready</b></span></a>
        <nav aria-label="Main">
          <a href="/mods">All mods</a>
          <a href="/list">My list</a>
          <a href="/badges">Badges</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap small muted">
        <p>
          Data from <a href="https://modrinth.com" rel="noopener">Modrinth</a> and the Mojang version manifest.
          Updated <time datetime={m.generatedAt} data-ago>{m.generatedAt.slice(0, 16).replace('T', ' ')} UTC</time>.
          {DECLARED_NOTE}
        </p>
        <p>
          Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.
        </p>
        <p>
          <a href="/report">Adoption reports</a> · <a href="/badges">Badges for mod authors</a> · <a href="/about">About</a>
        </p>
        <p>
          No accounts, no cookies, no tracking. Your lists live in your browser.
          {KOFI && <> · <a href={KOFI} rel="noopener">Support the site on Ko-fi</a></>}
        </p>
      </div>
    </footer>
    <script>
      // "Updated" time + stale-data banner, based on the LIVE data (meta.json), not when this page was built:
      // pages are only rebuilt nightly, but data refreshes more often.
      import { DATA_BASE } from '../lib/ui/status';
      const t = document.querySelector<HTMLTimeElement>('time[data-ago]');
      const show = (iso: string) => {
        if (!t) return;
        const age = Date.now() - Date.parse(iso);
        const h = Math.round(age / 3.6e6);
        t.dateTime = iso;
        t.textContent = h < 1 ? 'less than an hour ago' : h < 48 ? `${h}h ago` : `${Math.round(h / 24)} days ago`;
        if (age > 36 * 3.6e6 && !document.querySelector('.stale')) {
          const b = document.createElement('div');
          b.className = 'stale';
          b.setAttribute('role', 'status');
          b.textContent = `Heads up: data was last refreshed ${t.textContent}. Statuses may be out of date.`;
          document.querySelector('main')?.prepend(b);
        }
      };
      fetch(`${DATA_BASE}/meta.json`)
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((m: { generatedAt: string }) => show(m.generatedAt))
        .catch(() => t && show(t.dateTime));
    </script>
    <style>
      .site-header { position: relative; background: #1e2125; color: #f1efe8; margin-bottom: 32px; border-bottom: 2px solid #0b0c0e; }
      /* pixel grass edge hanging over a strip of dirt */
      .site-header::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 12px; background: var(--grass-strip) repeat-x; background-size: 32px 12px; image-rendering: pixelated; border-bottom: 2px solid #0b0c0e; }
      .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; flex-wrap: wrap; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--pixel); font-weight: 400; font-size: 32px; text-decoration: none; color: #f1efe8; text-shadow: 2px 2px 0 #000; }
      .brand b { color: #8fd655; font-weight: 600; }
      .brand .m { color: #d8d4c8; }
      .logo { display: inline-flex; width: 30px; height: 30px; filter: drop-shadow(0 2px 0 #000); }
      .logo :global(svg) { width: 100%; height: 100%; }
      nav { display: flex; gap: 16px; }
      nav a { color: #f1efe8; text-decoration: none; font-family: var(--pixel); font-weight: 400; font-size: 24px; text-shadow: 2px 2px 0 #000; }
      nav a:hover { color: #8fd655; }
      .site-footer { border-top: 2px solid var(--outline); margin-top: 48px; padding: 16px 0 32px; background: var(--surface-2); }
      :global(.stale) { background: var(--s-pre-bg); color: var(--s-pre); padding: 8px 12px; border: 2px solid currentColor; border-radius: 3px; margin-bottom: 16px; }
    </style>
  </body>
</html>
