---
// Pre-rendered pages for the most downloaded mods (search traffic). Every other mod is served by
// /m?p=<slug>, which the 404 page redirects to, so /mod/<anything> always works.
import Base from '../../layouts/Base.astro';
import ModView from '../../components/ModView.svelte';
import { hasMod, meta, modFile, pages } from '../../lib/build-data';
import { LOADER_LABEL } from '../../lib/ui/status';
import type { Loader } from '../../lib/core/types';

export function getStaticPaths() {
  return pages().map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}

const { id } = Astro.props as { id: string };
const mod = modFile(id);
const m = meta();
const latest = m.drops.find((d) => !d.upcoming)!;
const loaders = (Object.keys(mod.loaders) as Loader[]).map((l) => LOADER_LABEL[l]).join(' / ');

// Titles for alternative links (by slug).
const altSlugs = new Set(Object.values(mod.alts ?? {}).flatMap((byDrop) => Object.values(byDrop ?? {}).flat().map((a) => a.slug)));
const titles: Record<string, string> = {};
const slugToId = new Map(pages().map((p) => [p.slug, p.id]));
for (const s of altSlugs) {
  const altId = slugToId.get(s);
  if (altId && hasMod(altId)) titles[s] = modFile(altId).title;
}
---

<Base
  title={`Is ${mod.title} updated for Minecraft ${latest.id}? (${loaders})`}
  description={`Is ${mod.title} ready for Minecraft ${latest.id}? See its status for every recent version, older versions like ${m.popularLegacy.fabric?.[0] ?? '1.20.1'}, update speed, and alternatives.`}
>
  <ModView mod={mod} drops={m.drops} versions={m.versions} popularLegacy={m.popularLegacy} {titles} />
</Base>
