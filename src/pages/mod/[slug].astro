---
// One pre-rendered page per tracked mod, e.g. "Is Sodium ready for 26.3?". Rebuilt nightly.
import Base from '../../layouts/Base.astro';
import { meta, project, projectSlugs } from '../../lib/build-data';
import { ENV, LOADER_LABEL, STATUS, DECLARED_NOTE, fmtDownloads, modrinthUrl } from '../../lib/ui/status';
import type { Loader } from '../../lib/core/types';

export function getStaticPaths() {
  return projectSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const p = project(slug!);
const m = meta();
const latest = m.drops.find((d) => !d.upcoming)!;
const loaders = Object.keys(p.loaders) as Loader[];
const released = m.drops.filter((d) => !d.upcoming);
const titleOf = (s: string) => {
  try {
    return project(s).title;
  } catch {
    return s;
  }
};

const verdict = loaders.map((l) => ({ l, s: p.loaders[l]!.cells[latest.id]?.status ?? 'unknown' }));
const anyReady = verdict.some((v) => v.s === 'ready');
const answer = anyReady
  ? `Yes: ${p.title} has a release declared for ${latest.id} on ${verdict.filter((v) => v.s === 'ready').map((v) => LOADER_LABEL[v.l]).join(' and ')}.`
  : `Not yet: ${p.title} has no release declared for ${latest.id}${verdict.some((v) => v.s === 'prerelease') ? ' (beta builds are available)' : ''}.`;
---

<Base
  title={`Is ${p.title} updated for Minecraft ${latest.id}? (${loaders.map((l) => LOADER_LABEL[l]).join(' / ')})`}
  description={`${answer} See ${p.title} readiness for every recent Minecraft version, how fast it usually updates, and alternatives.`}
>
  <article>
    <header class="head">
      {p.icon && <img class="icon" src={p.icon} alt="" width="64" height="64" />}
      <div>
        <h1>Is {p.title} ready for {latest.id}?</h1>
        <p class="answer">{answer}</p>
        <p class="muted small">
          {fmtDownloads(p.downloads)} downloads · {ENV[p.env]} · <a href={modrinthUrl(p.slug)} rel="noopener">View on Modrinth</a>
        </p>
      </div>
    </header>
    <p class="small muted">{p.description}</p>

    <div class="grid grid-2">
      {loaders.map((l) => {
        const d = p.loaders[l]!;
        return (
          <section class="card">
            <h2>{LOADER_LABEL[l]}</h2>
            <table>
              <tbody>
                {m.drops.map((drop) => {
                  const c = d.cells[drop.id];
                  const waiting = drop.upcoming && c?.status === 'not_yet';
                  const st = waiting ? { icon: '…', label: 'Waiting' } : STATUS[c?.status ?? 'unknown'];
                  const cls = waiting ? 'not_applicable' : (c?.status ?? 'unknown');
                  return (
                    <tr>
                      <th scope="row">{drop.id}{drop.upcoming && <span class="muted small"> (upcoming)</span>}</th>
                      <td><span class={`chip s-${cls}`}><span class="i" aria-hidden="true">{st.icon}</span>{st.label}</span></td>
                      <td class="small muted">
                        {c?.lagDays != null && (c.lagDays === 0 ? 'day one' : `+${c.lagDays} days`)}
                        {c?.patches?.length ? ` · ${c.patches.join(', ')}` : ''}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            {Object.entries(d.alts).filter(([drop]) => drop === latest.id).map(([, alts]) => (
              <p class="small">
                {alts.some((a) => a.curated) ? 'Known replacements' : 'Similar mods ready for ' + latest.id}:{' '}
                {alts.map((a, i) => <>{i ? ', ' : ''}<a href={`/mod/${a.slug}`} title={a.note}>{titleOf(a.slug)}</a></>)}
                {!alts.some((a) => a.curated) && <span class="muted"> (similar category; check features before switching)</span>}
              </p>
            ))}
          </section>
        );
      })}
    </div>

    <section class="card history">
      <h2>Update history</h2>
      <p class="small muted">Days from each Minecraft release to {p.title}'s first release build.</p>
      <ul>
        {released.map((drop) => (
          <li>
            <strong>{drop.id}</strong>:{' '}
            {loaders.map((l, i) => {
              const lag = p.loaders[l]!.history[drop.id];
              return <>{i ? ' · ' : ''}{LOADER_LABEL[l]} {lag == null ? 'no release' : lag === 0 ? 'day one' : `${lag} days`}</>;
            })}
          </li>
        ))}
      </ul>
    </section>

    <p><a class="btn primary" href="/list">Check your whole mod list →</a></p>
    <p class="small muted">{DECLARED_NOTE}</p>
  </article>
</Base>

<style>
  .head { display: flex; gap: 16px; align-items: flex-start; }
  .icon { width: 64px; height: 64px; border-radius: 12px; flex: none; }
  h1 { font-size: clamp(1.5rem, 4vw, 2.2rem); }
  .answer { font-size: 1.15rem; }
  .grid { margin: 16px 0; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 6px 4px; border-bottom: 1px solid var(--border); }
  .history ul { margin: 0; padding-left: 20px; }
</style>
